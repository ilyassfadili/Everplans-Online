# ==============================================================================
# Everplans - environment template
#
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed. This template is the
# only env file that belongs in version control, and it never carries a value.
#
# Environments
#   local development  →  .env.local  (this machine only)
#   preview            →  Vercel → Project Settings → Environment Variables → Preview
#   production         →  Vercel → Project Settings → Environment Variables → Production
#
# Vercel injects these at build and run time, so the same variable names work
# unchanged across all three. Nothing below should ever be hardcoded in source.
# ==============================================================================


# ------------------------------------------------------------------------------
# Public - inlined into the browser bundle at build time.
#
# Anything with a NEXT_PUBLIC_ prefix is readable by every visitor. Only put
# values here that are safe to publish.
# ------------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key ("sb_publishable_..."). Designed to ship to browsers:
# it grants exactly the access your Row Level Security policies allow, and
# nothing more.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PayPal's client id (Everplans Money Prompt 8) - the same value as
# PAYPAL_CLIENT_ID below, just also under a NEXT_PUBLIC_ name so the
# checkout page's PayPal JS SDK (Card Fields + Buttons) can load with it.
# Not a secret - PayPal client ids are designed to ship to browsers.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=


# ------------------------------------------------------------------------------
# Server only - never given a NEXT_PUBLIC_ prefix, never read from client code.
#
# The Supabase secret key ("sb_secret_...") bypasses Row Level Security
# completely. Everplans Money Prompt 3 is the first real caller of this
# boundary: src/lib/orders.ts (order status transitions) and
# src/lib/commerce-provisioning.ts (granting/revoking a planner entitlement
# after a verified PayPal payment) both use src/lib/supabase/service.ts,
# which throws a clear error rather than silently falling back to anything
# less privileged if this isn't set. Required for the Budget Planner
# checkout flow to work at all. Read it exclusively from modules marked
# `import "server-only"`.
# ------------------------------------------------------------------------------

SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# PayPal - Everplans Money's payment processor (Prompt 3). Server only.
#
# Create a REST app at developer.paypal.com to get a Client ID/Secret for
# both Sandbox (testing) and Live (production) - they are separate
# credential pairs, never reused across environments.
# ------------------------------------------------------------------------------

# "sandbox" for testing, "live" for real charges. Defaults to "sandbox" if unset.
PAYPAL_ENVIRONMENT=sandbox

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The id of a webhook you create (in the PayPal developer dashboard, on the
# same REST app) pointed at this deployment's /api/webhooks/paypal - used
# only to verify an incoming webhook's signature, never to authenticate.
PAYPAL_WEBHOOK_ID=
